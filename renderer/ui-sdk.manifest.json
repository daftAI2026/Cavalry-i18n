      },
      {
        "name": "scroll-area",
        "mode": "web",
        "selector": "ui-scroll-area"
      },
      {
        "name": "progress",
        "mode": "web",
        "selector": "ui-progress"
      },
      {
        "name": "badge",
        "mode": "core",
        "selector": "cv-badge"
      },
      {
        "name": "item",
        "mode": "core",
        "selector": "cv-item"
      },
      {
        "name": "icon",
