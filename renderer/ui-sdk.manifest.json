        "selector": "cv-icon"
      },
      {
        "name": "link",
        "mode": "web",
        "selector": "ui-button:has(a)"
      },
      {
        "name": "marker",
        "mode": "core",
        "selector": "cv-marker"
      },
      {
        "name": "message",
        "mode": "core",
        "selector": "cv-message"
      },
      {
        "name": "spinner",
        "mode": "core",
