{
  "name": "cavalry-i18n",
  "private": true,
  "version": "0.5.3",
  "description": "Tauri desktop language patcher for Cavalry-i18n",
  "scripts": {
    "check:ui-coverage": "node tools/check_runtime_ui_coverage.js --inventory \"$SESSION_DIR/runtime/${LANGUAGE:-zh-Hans}-merged-inventory.json\" --threshold 100 --extraction-inventory \"$SESSION_DIR/extraction-inventory.json\"",
    "extract:compiled-ui": "node tools/extract_compiled_ui_strings.js --app /Applications/Cavalry.app --output \"$HOME/Library/Caches/Cavalry-i18n/compiled-ui-source-map.json\"",
    "check:full-ui:ja_JP": "node tools/check_full_ui_coverage.js --language ja_JP --inventory \"$SESSION_DIR/runtime/ja_JP-merged-inventory.json\" --compiled-source-map \"$HOME/Library/Caches/Cavalry-i18n/compiled-ui-source-map.json\" --ts tools/ja_JP.ts --threshold 100 --extraction-inventory \"$SESSION_DIR/extraction-inventory.json\"",
    "check:full-ui:zh-Hans": "node tools/check_full_ui_coverage.js --language zh-Hans --inventory \"$SESSION_DIR/runtime/zh-Hans-merged-inventory.json\" --compiled-source-map \"$HOME/Library/Caches/Cavalry-i18n/compiled-ui-source-map.json\" --ts tools/zh-Hans.ts --threshold 100 --extraction-inventory \"$SESSION_DIR/extraction-inventory.json\"",
    "check:full-ui:zh-Hant": "node tools/check_full_ui_coverage.js --language zh-Hant --inventory \"$SESSION_DIR/runtime/zh-Hant-merged-inventory.json\" --compiled-source-map \"$HOME/Library/Caches/Cavalry-i18n/compiled-ui-source-map.json\" --ts tools/zh-Hant.ts --threshold 100 --extraction-inventory \"$SESSION_DIR/extraction-inventory.json\"",
    "check:full-ui": "node tools/verify_gate_inputs.js --cache-root \"$HOME/Library/Caches/Cavalry-i18n\" --session-dir \"$SESSION_DIR\" --compiled-source-map \"$HOME/Library/Caches/Cavalry-i18n/compiled-ui-source-map.json\" --extraction-inventory \"$SESSION_DIR/extraction-inventory.json\" && node tools/check_full_ui_matrix.js --threshold 100 --session-dir \"$SESSION_DIR\" --compiled-source-map \"$HOME/Library/Caches/Cavalry-i18n/compiled-ui-source-map.json\" --extraction-inventory \"$SESSION_DIR/extraction-inventory.json\" --runlog \"$SESSION_DIR/full-ui-run-record.json\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.macos.conf.json",
    "build:tauri:windows": "npm run prepare:qt-sdk:windows && tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.windows.conf.json && node tools/windows_nsis_provenance.js --record",
    "build:injector:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File injector/windows/build.ps1",
    "prepare:tauri:windows-bundle": "npm run build:injector:windows && node tools/windows_nsis_provenance.js --prepare",
    "check:tauri": "cd src-tauri && cargo check",
    "test:tauri": "cd src-tauri && cargo test",
    "test:tauri:packaged": "node --test tools/check_tauri_packaged_app.js",
    "test:tauri:windows-nsis": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/check_windows_nsis_install.ps1",
    "test:tauri:dmg-layout": "bash tools/check_dmg_layout.sh src-tauri/target/release/bundle/dmg",
    "test:tauri:ui": "node --test tools/check_tauri_window_regression.js",
    "test:tauri:manual-smoke": "cd src-tauri && cargo test --test manual_macos_smoke -- --ignored --nocapture",
    "test:tauri:manual-windows-live-smoke": "cd src-tauri && cargo test --test manual_windows_live_smoke -- --ignored --nocapture",
    "prepare:qt-sdk": "node tools/resolve_cavalry_qt_sdk.js --ensure",
    "prepare:qt-sdk:windows": "node tools/resolve_cavalry_qt_sdk.js --platform windows --ensure",
    "build:injector": "eval \"$(node tools/resolve_cavalry_qt_sdk.js --print-env --ensure)\" && bash tools/build_translator_injector.sh injector/libCavalryTranslatorInjector.dylib",
    "build": "npm run tauri:build",
    "build:tauri": "npm run tauri:build && bash tools/stamp_dmg_icon.sh src-tauri/target/release/bundle/dmg && npm run test:tauri:packaged",
    "test:contracts": "node --test tools/check_app_contracts.js tools/check_renderer_contract.js tools/check_tauri_build_sop.js tools/check_tauri_bridge_runtime.js tools/check_git_hooks.js",
    "check:app": "node --check renderer/tauri-bridge.js && node --check renderer/app.js && node --check tools/check_renderer_contract.js && node --check tools/check_app_contracts.js && node --check tools/check_tauri_build_sop.js && node --check tools/check_tauri_bridge_runtime.js && node --check tools/check_tauri_packaged_app.js && node --check tools/check_tauri_window_regression.js && node --check tools/extract_release_changelog.js && node --check tools/install_git_hooks.js && node --check tools/pre_commit_gate.js && node --check tools/check_git_hooks.js && node --check tools/python_command.js && node --check tools/release_metadata.js && node --check tools/windows_nsis_provenance.js && node --check tools/window_contract_lib.js && node --check tools/fixtures/make_fake_cavalry_bundle.js",
    "sync:version": "node tools/sync_project_version.js",
    "check:version": "node tools/sync_project_version.js --check",
    "release:metadata": "node tools/release_metadata.js",
    "check:release": "node tools/release_metadata.js --check",
    "hooks:install": "node tools/install_git_hooks.js",
    "postinstall": "npm run hooks:install"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1"
  }
}
