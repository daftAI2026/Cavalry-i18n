{
  "name": "cavalry-i18n",
  "private": true,
  "version": "0.1.0",
  "description": "External Electron patcher for Cavalry-i18n",
  "main": "desktop-patcher/main.js",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tools/check_electron_patcher_ui.js tools/check_renderer_contract.js tools/check_electron_contract_snapshots.js tools/check_tauri_build_sop.js tools/check_tauri_bridge_runtime.js",
    "check:ui-coverage": "node tools/check_runtime_ui_coverage.js --inventory \"$HOME/Library/Caches/Cavalry-i18n/menu-inventory.json\" --threshold 99",
    "extract:compiled-ui": "node tools/extract_compiled_ui_strings.js --output doc/compiled-ui-source-map.json",
    "check:full-ui:ja_JP": "node tools/check_full_ui_coverage.js --language ja_JP --inventory \"$HOME/Library/Caches/Cavalry-i18n/ja_JP-inventory.json\" --compiled-source-map doc/compiled-ui-source-map.json --ts tools/ja_JP.ts --threshold 99",
    "check:full-ui:zh-Hans": "node tools/check_full_ui_coverage.js --language zh-Hans --inventory \"$HOME/Library/Caches/Cavalry-i18n/zh-Hans-inventory.json\" --compiled-source-map doc/compiled-ui-source-map.json --ts tools/zh-Hans.ts --threshold 99",
    "check:full-ui:zh-Hant": "node tools/check_full_ui_coverage.js --language zh-Hant --inventory \"$HOME/Library/Caches/Cavalry-i18n/zh-Hant-inventory.json\" --compiled-source-map doc/compiled-ui-source-map.json --ts tools/zh-Hant.ts --threshold 99",
    "check:full-ui": "node tools/check_full_ui_matrix.js --runlog full-ui-runlog.json",
    "check:desktop": "node --check desktop-patcher/main.js && node --check desktop-patcher/i18n-handlers.js && node --check desktop-patcher/preload.js && node --check desktop-patcher/lib/detect.js && node --check desktop-patcher/lib/patch.js && node --check desktop-patcher/lib/sudo.js && node --check desktop-patcher/renderer/tauri-bridge.js && node --check desktop-patcher/renderer/app.js && node --check tools/check_renderer_contract.js && node --check tools/electron_harness.js && node --check tools/capture_electron_contract.js && node --check tools/check_electron_contract_snapshots.js && node --check tools/check_tauri_build_sop.js && node --check tools/check_tauri_bridge_runtime.js && node --check tools/check_tauri_packaged_app.js && node --check tools/check_tauri_window_regression.js && node --check tools/capture_electron_window_baseline.js && node --check tools/window_contract_lib.js && node --check tools/fixtures/make_fake_cavalry_bundle.js",
    "capture:electron:window-baseline": "node tools/capture_electron_window_baseline.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:tauri": "cd src-tauri && cargo check",
    "test:tauri": "cd src-tauri && cargo test",
    "test:tauri:packaged": "node --test tools/check_tauri_packaged_app.js",
    "test:tauri:ui": "node --test tools/check_tauri_window_regression.js",
    "test:tauri:manual-smoke": "cd src-tauri && cargo test --test manual_macos_smoke -- --ignored --nocapture",
    "prepare:qt-sdk": "node tools/resolve_cavalry_qt_sdk.js --ensure",
    "build:injector": "eval \"$(node tools/resolve_cavalry_qt_sdk.js --print-env --ensure)\" && bash tools/build_translator_injector.sh desktop-patcher/injector/libCavalryTranslatorInjector.dylib",
    "build": "npm run tauri:build",
    "build:electron": "npm run build:injector && electron-builder -m && bash tools/stamp_dmg_icon.sh",
    "build:electron:dir": "npm run build:injector && electron-builder -m --dir",
    "build:dir": "npm run build:electron:dir",
    "build:tauri": "npm run tauri:build && bash tools/stamp_dmg_icon.sh src-tauri/target/release/bundle/dmg && npm run test:tauri:packaged"
  },
  "build": {
    "appId": "com.daftai.cavalry-i18n",
    "productName": "Cavalry Language Switcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-patcher/**/*",
      "languages/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-patcher/injector/libCavalryTranslatorInjector.dylib",
        "to": "injector/libCavalryTranslatorInjector.dylib"
      }
    ],
    "dmg": {
      "icon": "desktop-patcher/resources/icon.icns",
      "title": "Cavalry Language Switcher"
    },
    "mac": {
      "icon": "desktop-patcher/resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/cli": "2.10.1",
    "electron": "^35.5.1",
    "electron-builder": "^26.8.1"
  }
}
