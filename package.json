{
  "name": "cavalry-i18n",
  "private": true,
  "version": "0.1.0",
  "description": "External Electron patcher for Cavalry-i18n",
  "main": "desktop-patcher/main.js",
  "scripts": {
    "desktop": "electron .",
    "test:desktop": "node --test tools/check_electron_patcher_ui.js",
    "check:desktop": "node --check desktop-patcher/main.js && node --check desktop-patcher/preload.js && node --check desktop-patcher/lib/detect.js && node --check desktop-patcher/lib/patch.js && node --check desktop-patcher/lib/sudo.js && node --check desktop-patcher/renderer/app.js",
    "extract:compiled-ui": "node tools/extract_compiled_ui_strings.js --app /Applications/Cavalry.app --output doc/compiled-ui-source-map.json",
    "build:injector": "CAVALRY_QT_VERSION=6.6.3 bash tools/build_translator_injector.sh desktop-patcher/injector/libCavalryTranslatorInjector.dylib",
    "build": "npm run build:injector && electron-builder -m",
    "build:dir": "npm run build:injector && electron-builder -m --dir"
  },
  "build": {
    "appId": "com.daftai.cavalry-i18n",
    "productName": "Cavalry Patcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-patcher/**/*",
      "languages/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-patcher/injector/libCavalryTranslatorInjector.dylib",
        "to": "injector/libCavalryTranslatorInjector.dylib"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "^35.5.1",
    "electron-builder": "^26.8.1"
  }
}
