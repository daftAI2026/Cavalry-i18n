    "layerType": "skslShader",
    "attrs": [
      {
        "attrId": "code",
        "value": "half4 main(float2 fragCoord) {\n    // Normalized pixel coordinates (from 0 to 1)\n    float2 uv = fragCoord / resolution;\n\n    // Varying pixel color based on n0\n    float3 col = 0.5 + 0.5 * sin(n0 + float3(uv.x, uv.y, uv.x) + float3(0.0, 8.0, 16.0));\n\n    // Output color\n    return half4(col, 1.0);\n}"
      }
