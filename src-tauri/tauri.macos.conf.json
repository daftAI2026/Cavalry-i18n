{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeDevCommand": "npm run build:injector",
    "beforeBuildCommand": "npm run build:injector"
  },
  "bundle": {
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "../languages": "languages",
      "../injector/libCavalryTranslatorInjector.dylib": "injector/libCavalryTranslatorInjector.dylib"
    },
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "zh-Hant.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "ja.lproj/InfoPlist.strings"
      },
      "dmg": {
        "background": "icons/background.png",
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "windowSize": {
          "width": 800,
          "height": 476
        },
        "appPosition": {
          "x": 212,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 592,
          "y": 170
        }
      }
    }
  }
}
