{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cavalry Language Switcher",
  "version": "0.6.1",
  "identifier": "com.daftai.cavalry-i18n",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cavalry Language Switcher",
        "url": "index.html",
        "useHttpsScheme": false,
        "width": 480,
        "height": 528,
        "minWidth": 420,
        "minHeight": 528,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true
  }
}
