{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cavalry Language Switcher",
  "version": "0.7.0",
  "identifier": "com.daftai.cavalry-i18n",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cavalry Language Switcher",
        "url": "./index.html",
        "useHttpsScheme": false,
        "width": 400,
        "height": 484,
        "minWidth": 400,
        "minHeight": 484,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "default",
        "about"
      ]
    }
  },
  "bundle": {
    "active": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDRDdFNUIyRTIzQjk1QzQKUldURWxUdmlzdVhYN05HcFozNDdLeE1mMlAyakdZRWtrRktLNFk1SmpqSmptNDN6U0JmNFJSQ0wK",
      "endpoints": [
        "https://github.com/daftAI2026/Cavalry-i18n/releases/latest/download/latest.json"
      ]
    }
  }
}
