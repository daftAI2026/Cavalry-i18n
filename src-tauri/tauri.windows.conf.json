{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run prepare:tauri:windows-bundle"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../languages": "languages",
      "../injector/windows/generic/cavalryi18n.dll": "injector/windows/generic/cavalryi18n.dll",
      "../injector/windows/qpa/qwindows.dll": "injector/windows/qpa/qwindows.dll"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
