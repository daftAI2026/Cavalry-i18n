{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeDevCommand": "npm run build:injector:windows",
    "beforeBuildCommand": "npm run prepare:tauri:windows-bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cavalry Language Switcher",
        "url": "./index.html",
        "useHttpsScheme": false,
        "width": 400,
        "height": 484,
        "minWidth": 400,
        "minHeight": 484,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../languages": "languages",
      "../injector/windows/generic/cavalryi18n.dll": "injector/windows/generic/cavalryi18n.dll",
      "../injector/windows/qpa/qwindows.dll": "injector/windows/qpa/qwindows.dll"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese"
        ],
        "customLanguageFiles": {
          "English": "nsis-languages/English.nsh",
          "SimpChinese": "nsis-languages/SimpChinese.nsh",
          "TradChinese": "nsis-languages/TradChinese.nsh",
          "Japanese": "nsis-languages/Japanese.nsh"
        },
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
