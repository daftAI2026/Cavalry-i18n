#!/bin/sh
# [INPUT]: 依赖 Git 本地配置与 Node 运行时，读取安装器记录的 Node 绝对路径并委派 tools/pre_commit_gate.js
# [OUTPUT]: 对外提供零业务逻辑的跨平台 hook bootstrap；优先仓库级 Node，再安全回退 PATH/Windows 标准安装位置
# [POS]: tools/git-hooks 的进程入口，不直接修改暂存区；版本同步、路径门禁与显式 projection add 全部收敛到 Node gate
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

set -eu

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "pre-commit: 找不到当前 Git 工作树。" >&2
  exit 1
fi
cd "$REPO_ROOT"

NODE_BIN="$(git config --local --get cavalry-i18n.nodePath 2>/dev/null || true)"
if [ -n "$NODE_BIN" ] && "$NODE_BIN" --version >/dev/null 2>&1; then
  :
elif command -v node >/dev/null 2>&1; then
  NODE_BIN="$(command -v node)"
elif [ -x "/c/Program Files/nodejs/node.exe" ]; then
  NODE_BIN="/c/Program Files/nodejs/node.exe"
else
  echo "pre-commit: 找不到 Node.js；请安装 Node.js 或将 node 加入 PATH。" >&2
  exit 1
fi

exec "$NODE_BIN" tools/pre_commit_gate.js
