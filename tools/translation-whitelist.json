{
  "nodeStrings": {
    "translate": ["niceName", "attributes", "enums", "nodeInfo", "tabs"],
    "no_translate": ["type", "nodeType"],
    "locale_sync": ["language"]
  },
  "appStrings": {
    "translate": ["value"],
    "no_translate": ["type"],
    "locale_sync": ["language"]
  },
  "tips": {
    "translate": ["title", "text"],
    "no_translate": ["images", "beginner"]
  },
  "onboarding": {
    "translate": ["title"],
    "no_translate": ["images"]
  },
  "plugins": {
    "translate": ["niceName", "layerInfo", "attributes", "enums"],
    "no_translate": ["type", "author", "layerType"],
    "locale_sync": ["language"]
  },
  "_forbidden_patterns": {
    "transliteration_ban": {
      "id": "FP-10",
      "contract": "字体家族名、颜色品牌内部代号、Unicode glyph 名、错误码碎片、长度 <= 6 的无义 ASCII 短串不得音译；应 no_translate 或 glossary-controlled。"
    },
    "pangram_skip": {
      "id": "FP-11",
      "contract": "字体样本 pangram / glyph sample 噪声不得翻译；G-X 必须剔除，若进入 TS/inc 则 hard-fail。"
    },
    "translation_reuse_cap": {
      "id": "FP-12",
      "contract": "同一非受控 translation 不得跨超过 2 个不同 source 复用；controlledVocabulary 之外视为占位复用。",
      "max_distinct_sources": 2,
      "min_translation_length": 6,
      "controlled_vocabulary": ["OK", "取消", "キャンセル", "確定", "确定", "開く", "打开", "关闭", "關閉"]
    }
  },
  "_extraction_filters": {
    "glossary_source": "doc/workflows/cavalry-full-ui-100/Anti-Patterns.md §F",
    "exact_values": [
      "Acce",
      "Acutesmall",
      "Apple Color Emoji",
      "Arial",
      "Asse",
      "Audif",
      "Ayhb",
      "B ffff.",
      "close button",
      "group",
      "minimize button",
      "standard window",
      "text",
      "zoom button"
    ],
    "regexes": [
      "^(?:[a-z]{2,4}\\s+[A-Z]{2,4}\\s+){2,}",
      "^[A-Z]\\s+[a-z]{4,}\\.$",
      "^(?:[A-Z](?:acute|grave|caron|tilde|breve|cedilla|ogonek|macron|dieresis|circumflex|dotaccent|hungarumlaut|ring)(?:small)?|[A-Z]small|[A-Z](?:slash|th)small|(?:Acute|Breve|Caron|Cedilla|Circumflex|Dieresis|Dotaccent|Grave|Hungarumlaut|Macron|Ogonek|Ring|Tilde)small)$",
      "^(?:Adlam|Ahom|Arabic|Bamum|Batak|Bhaiksuki|Brahmi|Buhid|Carian|Chakma|Cham|Coptic|Cypriot|Dogra|Duployan|Elbasan|Elymaic|Glagolitic|Grantha|Greek|Gujarati|Gurmukhi|Hangul|Hanunoo|Hatran|Hebrew|Hiragana|Javanese|Kaithi|Kannada|Katakana|Kharoshthi|Khmer|Khojki|Khudawadi|Latin|Lepcha|Limbu|Lisu|Lycian|Lydian|Mahajani|Malayalam|Mandaic|Manichaean|Marchen|Medefaidrin|Miao|Modi|Mongolian|Multani|Myanmar|Nabataean|Odia|Osmanya|Rejang|Runic|Samaritan|Saurashtra|Sharada|Shavian|Siddham|Sinhala|Sogdian|Soyombo|Sundanese|Syriac|Tagalog|Tagbanwa|Takri|Tamil|Telugu|Thaana|Thai|Tibetan|Tifinagh|Tirhuta|Ugaritic)$",
      "^(?:Aquamarine|Azure|Beige|Black|Blue|Brown|Chartreuse|Chocolate|Coral|Crimson|Fuchsia|Gold|Gray|Green|Grey|Indigo|Ivory|Khaki|Lavender|Lime|Linen|Magenta|Maroon|Olive|Orange|Orchid|Pink|Plum|Purple|Salmon|Silver|Teal|Thistle|Turquoise|Violet|Wheat|White|Yellow)$"
    ]
  },

  "_schema": {
    "translate": "值包含面向用户的自然语言，必须完整翻译为目标语言",
    "no_translate": "值是程序标识符，必须与 en/ 原文完全一致",
    "locale_sync": "值必须改为目标语言代码（如 zh-Hans / zh-Hant / ja_JP）"
  }
}
