{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daftAI2026/Cavalry-i18n/tools/schemas/release_acceptance_seal.schema.json",
  "title": "ReleaseAcceptanceSeal",
  "description": "Cryptographically signed final release commitment for verified live acceptance, supply-chain sidecars, and artifact digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "tag",
    "releaseCommitSha",
    "sourceCommitSha",
    "targetCavalryVersion",
    "qtVersion",
    "languages",
    "acceptanceEvidence",
    "assets",
    "supplyChain",
    "signing",
    "createdAtUtc",
    "createdBy",
    "signature",
    "acceptanceAttestation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 5
    },
    "kind": {
      "type": "string",
      "const": "ReleaseAcceptanceSeal"
    },
    "tag": {
      "type": "string",
      "pattern": "^cavalry-2\\.7\\.2-p[0-9]+$"
    },
    "releaseCommitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceCommitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "targetCavalryVersion": {
      "type": "string",
      "const": "2.7.2"
    },
    "qtVersion": {
      "type": "string",
      "const": "6.6.3"
    },
    "languages": {
      "type": "array",
      "prefixItems": [
        {
          "const": "zh-Hans"
        },
        {
          "const": "zh-Hant"
        },
        {
          "const": "ja_JP"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "acceptanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256",
        "sessionId",
        "sessionManifestSha256",
        "finalRecordSha256",
        "host",
        "windowsAcceptance"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^cavalry-2\\.7\\.2-p[0-9]+\\.evidence\\.json$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "sessionManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "finalRecordSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "productVersion",
            "buildVersion"
          ],
          "properties": {
            "productVersion": {
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+){1,2}$"
            },
            "buildVersion": {
              "type": "string",
              "pattern": "^\\d{2}[A-Z][0-9A-Za-z]{1,15}$"
            }
          }
        },
        "windowsAcceptance": {
          "$ref": "#/$defs/windowsAcceptance"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aarch64",
        "x64",
        "windowsX64",
        "updaterManifest",
        "updaterAarch64",
        "updaterAarch64Signature",
        "updaterX64",
        "updaterX64Signature",
        "updaterWindowsX64Signature"
      ],
      "properties": {
        "aarch64": {
          "$ref": "#/$defs/asset"
        },
        "x64": {
          "$ref": "#/$defs/asset"
        },
        "windowsX64": {
          "$ref": "#/$defs/asset"
        },
        "updaterManifest": {
          "$ref": "#/$defs/asset"
        },
        "updaterAarch64": {
          "$ref": "#/$defs/asset"
        },
        "updaterAarch64Signature": {
          "$ref": "#/$defs/asset"
        },
        "updaterX64": {
          "$ref": "#/$defs/asset"
        },
        "updaterX64Signature": {
          "$ref": "#/$defs/asset"
        },
        "updaterWindowsX64Signature": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macosDeveloperIdNotarized",
        "windowsAuthenticode"
      ],
      "properties": {
        "macosDeveloperIdNotarized": {
          "const": true
        },
        "windowsAuthenticode": {
          "const": "required-but-tracked-as-issue"
        }
      }
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sbom",
        "toolchainEvidence"
      ],
      "properties": {
        "sbom": {
          "$ref": "#/$defs/asset"
        },
        "toolchainEvidence": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "payloadSha256",
        "publicKeySpkiBase64",
        "publicKeySha256",
        "signatureBase64"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publicKeySpkiBase64": {
          "type": "string",
          "minLength": 1
        },
        "publicKeySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signatureBase64": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptanceAttestation": {
      "$ref": "#/$defs/asset"
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "windowsAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "tag",
        "result",
        "matrix",
        "profile",
        "producer",
        "sessionId",
        "sourceCommitSha",
        "targetCavalryVersion",
        "qtVersion",
        "architecture",
        "finalRecord",
        "machineRecord",
        "manualReview",
        "sessionSentinel",
        "sessionManifestSha256",
        "installer",
        "provenance",
        "shippedDlls",
        "runner"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "WindowsReleaseAcceptance" },
        "tag": { "type": "string", "pattern": "^cavalry-2\\.7\\.2-p[0-9]+$" },
        "result": { "type": "string", "pattern": "^PASS-[1-9][0-9]*-OF-[1-9][0-9]*$" },
        "matrix": { "type": "string", "pattern": "^[1-9][0-9]*-screenshot/[1-9][0-9]*-point$" },
        "profile": {
          "enum": [
            "windows-onboarding-v1",
            "windows-adjacent-v1",
            "windows-onboarding-adjacent-v1"
          ]
        },
        "producer": { "const": "tools/windows-acceptance" },
        "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
        "sourceCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "targetCavalryVersion": { "const": "2.7.2" },
        "qtVersion": { "const": "6.6.3" },
        "architecture": { "const": "x86_64" },
        "finalRecord": { "$ref": "#/$defs/fileDigest" },
        "machineRecord": { "$ref": "#/$defs/fileDigest" },
        "manualReview": { "$ref": "#/$defs/fileDigest" },
        "sessionSentinel": { "$ref": "#/$defs/fileDigest" },
        "sessionManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "installer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "bytes", "sha256"],
          "properties": {
            "fileName": { "type": "string", "pattern": "^[^\\/]+x64-setup\\.exe$" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "bytes", "sha256"],
          "properties": {
            "fileName": { "type": "string", "pattern": "^[^\\/]+\\.provenance\\.json$" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "shippedDlls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generic", "qpa"],
          "properties": {
            "generic": { "$ref": "#/$defs/windowsShippedDll" },
            "qpa": { "$ref": "#/$defs/windowsShippedDll" }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch", "runnerOs", "runnerArch", "imageOs", "imageVersion", "node", "npm", "rustc", "cargo", "cmake", "powershell"],
          "properties": {
            "os": { "const": "win32" },
            "arch": { "const": "x64" },
            "runnerOs": { "type": "string", "minLength": 1 },
            "runnerArch": { "type": "string", "minLength": 1 },
            "imageOs": { "type": "string", "minLength": 1 },
            "imageVersion": { "type": "string", "minLength": 1 },
            "node": { "type": "string", "minLength": 1 },
            "npm": { "type": "string", "minLength": 1 },
            "rustc": { "type": "string", "minLength": 1 },
            "cargo": { "type": "string", "minLength": 1 },
            "cmake": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "powershell": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "windowsShippedDll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "bytes", "sha256"],
      "properties": {
        "relativePath": { "enum": ["injector/windows/generic/cavalryi18n.dll", "injector/windows/qpa/qwindows.dll"] },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
