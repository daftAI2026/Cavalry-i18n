{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daftAI2026/Cavalry-i18n/tools/schemas/windows_nsis_provenance.schema.json",
  "title": "WindowsNsisProvenance",
  "description": "Exact Windows x64 NSIS installer identity, optional Tauri updater signature identity, and packaging-input fingerprint shared by the package producer and release acceptance verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "productName",
    "version",
    "installer",
    "updaterSignature",
    "inputFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "target": { "const": "x86_64-pc-windows-msvc" },
    "productName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "installer": { "$ref": "#/$defs/fileIdentity" },
    "updaterSignature": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/fileIdentity" }
      ]
    },
    "inputFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "files"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputIdentity" }
        }
      }
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
