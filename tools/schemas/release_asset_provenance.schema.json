{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daftAI2026/Cavalry-i18n/tools/schemas/release_asset_provenance.schema.json",
  "title": "ReleaseAssetProvenance",
  "description": "Public byte identities for the signed release seal, SBOM, toolchain evidence, and the complete manual-installer/updater distribution closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "tag",
    "releaseCommitSha",
    "sourceCommitSha",
    "createdAtUtc",
    "assets",
    "signedSeal",
    "supplyChain",
    "signing",
    "acceptanceAttestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "ReleaseAssetProvenance"
    },
    "tag": {
      "type": "string",
      "pattern": "^cavalry-2\\.7\\.2-p[0-9]+$"
    },
    "releaseCommitSha": {
      "$ref": "#/$defs/sha"
    },
    "sourceCommitSha": {
      "$ref": "#/$defs/sha"
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "signedSeal": {
      "$ref": "#/$defs/asset"
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sbom",
        "toolchainEvidence"
      ],
      "properties": {
        "sbom": {
          "$ref": "#/$defs/asset"
        },
        "toolchainEvidence": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos",
        "windows"
      ],
      "properties": {
        "macos": {
          "const": "developer-id-notarized"
        },
        "windows": {
          "const": "authenticode-required-but-tracked-as-issue"
        }
      }
    },
    "acceptanceAttestation": {
      "$ref": "#/$defs/asset"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^/\\\\]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
