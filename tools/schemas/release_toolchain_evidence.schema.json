{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daftAI2026/Cavalry-i18n/tools/schemas/release_toolchain_evidence.schema.json",
  "title": "ReleaseToolchainEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releaseCommitSha", "createdAtUtc", "records", "uncoveredArtifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ReleaseToolchainEvidence" },
    "releaseCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "object" }
    },
    "uncoveredArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "assetName", "status", "issueUrl"],
        "properties": {
          "platform": { "const": "windows-x64" },
          "assetName": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "status": { "const": "tracked-as-issue" },
          "issueUrl": { "const": "https://github.com/daftAI2026/Cavalry-i18n/issues/15" }
        }
      }
    }
  }
}
