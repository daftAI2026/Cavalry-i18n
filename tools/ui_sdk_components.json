{
  "schemaVersion": 2,
  "primitives": [
    {
      "name": "button",
      "mode": "web",
      "selector": "ui-button:has(button)"
    },
    {
      "name": "select",
      "mode": "web",
      "selector": "ui-select"
    },
    {
      "name": "tooltip",
      "mode": "web",
      "selector": "ui-tooltip"
    },
    {
      "name": "alert-dialog",
      "mode": "web",
      "selector": "ui-alert-dialog"
    },
    {
      "name": "toast",
      "mode": "web",
      "selector": "ui-toast-region"
    },
    {
      "name": "progress",
      "mode": "web",
      "selector": "ui-progress"
    },
    {
      "name": "link",
      "mode": "web",
      "selector": "ui-button:has(a)"
    },
    {
      "name": "log-follow",
      "mode": "core-behavior",
      "selector": "#statusViewport",
      "factory": "createStickToBottom"
    }
  ],
  "compositions": [
    {
      "name": "activity",
      "mode": "business",
      "selector": "#statusPanel",
      "controller": "renderer/operation-log.js"
    },
    {
      "name": "permission-handoff",
      "mode": "business",
      "selector": "ui-alert-dialog",
      "controller": "renderer/permission-handoff.js"
    },
    {
      "name": "window-controls",
      "mode": "business",
      "selector": ".titlebar, .windows-window-controls",
      "controller": "renderer/window-controls.js"
    },
    {
      "name": "about",
      "mode": "business",
      "selector": ".about-window",
      "controller": "renderer/about-window.js"
    },
    {
      "name": "support-footer",
      "mode": "business",
      "selector": ".support-footer",
      "controller": "renderer/support-footer.js"
    },
    {
      "name": "follow-hand",
      "mode": "business",
      "selector": ".support-follow-hand",
      "controller": "renderer/support-follow-hand.js"
    }
  ]
}
