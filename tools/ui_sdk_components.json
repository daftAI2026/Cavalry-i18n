{
  "schemaVersion": 1,
  "primitives": [
    { "name": "button", "mode": "web", "selector": "ui-button:has(button)" },
    { "name": "select", "mode": "core", "selector": "cv-select" },
    { "name": "tooltip", "mode": "core", "selector": "cv-tooltip" },
    { "name": "alert-dialog", "mode": "core-native-dialog", "selector": "cv-alert-dialog" },
    { "name": "toast", "mode": "core-main-presence", "selector": "ui-toast-region" },
    { "name": "scroll-area", "mode": "web", "selector": "ui-scroll-area" },
    { "name": "progress", "mode": "web", "selector": "ui-progress" },
    { "name": "badge", "mode": "core", "selector": "cv-badge" },
    { "name": "item", "mode": "core", "selector": "cv-item" },
    { "name": "icon", "mode": "core", "selector": "cv-icon" },
    { "name": "link", "mode": "web", "selector": "ui-button:has(a)" },
    { "name": "marker", "mode": "core", "selector": "cv-marker" },
    { "name": "message", "mode": "core", "selector": "cv-message" },
    { "name": "spinner", "mode": "core", "selector": "cv-spinner" },
    { "name": "shimmer", "mode": "core", "selector": "cv-shimmer" }
  ],
  "compositions": [
