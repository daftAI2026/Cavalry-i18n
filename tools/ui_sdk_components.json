    { "name": "window-controls", "selector": "cv-window-frame, cv-window-controls", "controller": "renderer/window-controls.js" },
    { "name": "about", "selector": "cv-about", "controller": "renderer/about-window.js" },
    { "name": "support-footer", "selector": "cv-support-footer", "controller": "renderer/support-footer.js" },
    { "name": "follow-hand", "selector": "cv-follow-hand", "controller": "renderer/support-follow-hand.js" }
  ]
}
