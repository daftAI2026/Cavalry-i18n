    {
      "id": "behaviourBasics",
      "category": "followUp",
      "labelKey": "onboarding.nextGuide.behaviourBasics.label",
      "descriptionKey": "onboarding.nextGuide.behaviourBasics.description",
      "requiredWidgets": [
        "viewport",
        "sceneTree",
        "attributeEditor",
        "timeline"
      ],
      "validationFailScript": "var m = new ui.Modal(); if (m.showConfirmation('{{onboarding.dialog.resetWorkspace.title}}', '{{onboarding.dialog.resetWorkspace.body}}')) { api.resetWorkspace(); }",
      "setupScript": "var layers = api.getCompLayers(true); if (layers.length > 0) { var compId = api.createComp('{{onboarding.comp.behaviourGuide.name}}'); api.setActiveComp(compId); } var ellipseId = api.primitive('ellipse', '{{onboarding.layer.ellipse.name}}'); api.set(ellipseId, {'generator.radius': [5, 5]}); var dupId = api.create('duplicator', '{{onboarding.layer.duplicator.name}}'); api.connect(ellipseId, 'id', dupId, 'shapes'); api.set(dupId, {'generator.count': [15, 15], 'generator.size': [75, 75], 'generator.distributionMode': 1}); var colorId = api.create('colorArray', '{{onboarding.layer.colours.name}}'); api.addArrayIndex(colorId, 'array'); api.addArrayIndex(colorId, 'array'); api.addArrayIndex(colorId, 'array'); api.addArrayIndex(colorId, 'array'); api.set(colorId, {'array.0': '#a35fbf', 'array.1': '#05c7c2', 'array.2': '#f2e205', 'array.3': '#f27405', 'array.4': '#f20505'}); api.connect(colorId, 'id', ellipseId, 'material.materialColor'); api.select([dupId]); api.showInAttributeEditor(dupId);",
      "steps": [
        {
          "widgetTag": "attributeEditor",
          "titleKey": "onboarding.behaviourBasics.step0.title",
          "bodyKey": "onboarding.behaviourBasics.step0.body",
          "side": "left",
          "showArrow": false,
          "highlightRow": "shapePosition",
          "advanceEvent": "behaviourAdded"
        },
        {
          "widgetTag": "sceneTree",
          "titleKey": "onboarding.behaviourBasics.step1.title",
          "bodyKey": "onboarding.behaviourBasics.step1.body",
          "side": "top",
          "showArrow": true,
          "advanceEvent": "nodeUIAdded:noise"
        },
        {
          "widgetTag": "attributeEditor",
          "titleKey": "onboarding.behaviourBasics.step2.title",
          "bodyKey": "onboarding.behaviourBasics.step2.body",
          "side": "left",
          "showArrow": false,
          "highlightRow": "strength",
          "advanceEvent": "strengthAboveThreshold"
        },
        {
          "widgetTag": "attributeEditor",
          "titleKey": "onboarding.behaviourBasics.step3.title",
          "bodyKey": "onboarding.behaviourBasics.step3.body",
          "side": "left",
          "showArrow": false,
          "advanceEvent": "falloffAdded"
        },
        {
          "widgetTag": "sceneTree",
          "titleKey": "onboarding.behaviourBasics.step4.title",
          "bodyKey": "onboarding.behaviourBasics.step4.body",
          "side": "top",
          "showArrow": true,
          "advanceEvent": "nodeUIAdded:falloff"
        },
        {
          "widgetTag": "attributeEditor",
          "titleKey": "onboarding.behaviourBasics.step5.title",
          "bodyKey": "onboarding.behaviourBasics.step5.body",
          "side": "left",
          "showArrow": false,
          "highlightRow": "scale",
          "advanceEvent": "falloffScaleSet"
        },
        {
          "widgetTag": "playButton",
          "fallbackWidgetTag": "playbackControls",
          "titleKey": "onboarding.behaviourBasics.step6.title",
          "bodyKey": "onboarding.behaviourBasics.step6.body",
          "nextButtonKey": "onboarding.button.done.tada",
          "side": "top",
          "showArrow": true
        }
      ]
    },
