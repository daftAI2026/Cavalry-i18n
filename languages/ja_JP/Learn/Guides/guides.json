    {
      "id": "animationBasics",
      "category": "followUp",
      "labelKey": "onboarding.nextGuide.animationBasics.label",
      "descriptionKey": "onboarding.nextGuide.animationBasics.description",
      "requiredWidgets": [
        "viewport",
        "attributeEditor",
        "timeline"
      ],
      "validationFailScript": "var m = new ui.Modal(); if (m.showConfirmation('{{onboarding.dialog.resetWorkspace.title}}', '{{onboarding.dialog.resetWorkspace.body}}')) { api.resetWorkspace(); }",
      "setupScript": "var layers = api.getCompLayers(true); if (layers.length > 0) { var compId = api.createComp('{{onboarding.comp.animationGuide.name}}'); api.setActiveComp(compId); } var shapeId = api.primitive('ellipse', '{{onboarding.layer.myShape.name}}'); api.set(shapeId, {'material.materialColor': '#4faffd', 'position.x': -500, 'generator.radius': {'x':150, 'y':150}}); api.select([shapeId]); api.showInAttributeEditor(shapeId); api.set(api.getActiveComp(), {'endFrame': 100, 'playbackEnd': 100});",
      "steps": [
        {
          "widgetTag": "attributeEditor",
          "titleKey": "onboarding.animationBasics.step0.title",
          "bodyKey": "onboarding.animationBasics.step0.body",
          "side": "left",
          "showArrow": false,
          "forceKeyButtons": "position.x",
          "highlightRow": "position.x",
          "advanceEvent": "keyframeAdded"
        },
        {
          "widgetTag": "timeline",
          "titleKey": "onboarding.animationBasics.step1.title",
          "bodyKey": "onboarding.animationBasics.step1.body",
          "side": "top",
          "showArrow": true,
          "advanceEvent": "timeChanged"
        },
        {
          "widgetTag": "viewport",
          "titleKey": "onboarding.animationBasics.step2.title",
          "bodyKey": "onboarding.animationBasics.step2.body",
          "side": "left",
          "showArrow": false,
          "align": "bottom",
          "setupScript": "api.setActiveTool('select'); var sel = api.getSelection(); var guideId = api.primitive('ellipse', 'Target'); api.set(guideId, {'position.x': 500, 'generator.radius': {'x':175, 'y':175}}); api.setFill(guideId, false); api.setStroke(guideId, true); api.set(guideId, {'stroke.strokeColor': '#808080', 'stroke.dashPattern': '10, 10', 'locked': true}); if (sel.length > 0) { api.select(sel); }",
          "advanceEvent": "positionAboveThreshold"
        },
        {
          "widgetTag": "timeline",
          "titleKey": "onboarding.animationBasics.step3.title",
          "bodyKey": "onboarding.animationBasics.step3.body",
          "side": "left",
          "showArrow": true,
          "anchorKeyframe": "position.x:0",
          "advanceEvent": "easingSet"
        },
        {
          "widgetTag": "playButton",
          "fallbackWidgetTag": "playbackControls",
          "titleKey": "onboarding.animationBasics.step4.title",
          "bodyKey": "onboarding.animationBasics.step4.body",
          "nextButtonKey": "onboarding.button.done.tada",
          "setupScript": "api.setFrame(0);",
          "side": "top",
          "showArrow": true
        }
      ]
    },
    {
